{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageProjectTerraformStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:Get*",
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:GetBucketAcl"
      ],
      "Resource": "arn:aws:s3:::cdec-tfstate-234768038939-us-east-2"
    },
    {
      "Sid": "ManageProjectTerraformStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::cdec-tfstate-234768038939-us-east-2/*"
    },
    {
      "Sid": "ManageTerraformLockFiles",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::cdec-tfstate-234768038939-us-east-2/*.tflock"
    }
  ]
}
