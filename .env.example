# Copy with scripts/init-env.sh. Do not commit the populated .env file.
POSTGRES_DB=cross_domain_email
POSTGRES_USER=cdec_app
POSTGRES_PASSWORD=
APP_KEY=

# Cloudflare R2 private archival; leave blank until the bucket and read key exist.
# Worker access to R2 uses a binding and DOES NOT need these keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional outbound SMTP. Leave unset until sender DNS/domain is verified.
# Resend example: host smtp.resend.com, port 587, username resend,
# password = dedicated SMTP-capable Resend API key. Do not commit the key.
# MAIL_SCHEME=smtp on port 587 negotiates STARTTLS with the provider.
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
OUTBOUND_PROVIDER_LABEL=smtp
# Comma-separated domain names explicitly authorized in your SMTP provider.
OUTBOUND_ALLOWED_DOMAINS=

# Website-to-mail internal enquiry ingestion; match the website .env value.
# Generate 32 random bytes or more. Never commit an actual secret.
WEBSITE_CONTACT_BRIDGE_SECRET=
