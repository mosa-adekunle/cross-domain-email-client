{
  "name": "cross-domain-email/client-api",
  "type": "project",
  "description": "Laravel API foundation for the Cross Domain Email Client",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "aws/aws-sdk-php": "^3.300",
    "laravel/framework": "^13.0",
    "zbateson/mail-mime-parser": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
