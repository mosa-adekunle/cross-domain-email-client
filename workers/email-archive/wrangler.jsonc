{
  "name": "cdec-inbound-archive",
  "main": "src/index.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "r2_buckets": [
    {
      "binding": "MAIL_ARCHIVE",
      "bucket_name": "cdec-inbound-mail"
    }
  ],
  "vars": {
    "ALLOWED_RECIPIENTS": "inbox-test@receiptboss.ca,sales@receiptboss.ca,legal@receiptboss.ca,privacy@receiptboss.ca,hello@receiptboss.ca,sales@santasbag.ca,legal@santasbag.ca,privacy@santasbag.ca,hello@santasbag.ca,mosa@madenorth.dev,hello@madenorth.dev,sales@madenorth.dev"
  }
}
