[Unit]
Description=Cross Domain Email Client R2 incremental importer
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/cross-domain-email-client
ExecStart=/usr/bin/docker compose exec -T api php artisan mail:sync-r2 --mode=incremental --limit=100
TimeoutStartSec=180
